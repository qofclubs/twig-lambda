{
    "name": "mattimatti/twig-lambda",
    "type": "library",
    "description": "Lambda expressions for Twig and filters that make use of them",
    "keywords": [
        "lambda",
        "function",
        "unique",
        "functional",
        "filter",
        "map",
        "group",
        "sort"
    ],
    "minimum-stability": "dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Damian Polac",
            "email": "damian.polac.111@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:qofclubs/dictionary"
        }
    ],
    "require": {
        "php": "^8.2",
        "twig/twig": "^2.0 || ^3.0",
        "dpolac/dictionary": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "~5.0",
        "rector/rector": "dev-main",
        "friendsofphp/php-cs-fixer": "^3.9",
        "phpstan/phpstan": "2.0.x-dev"
    },
    "autoload": {
        "psr-4": {
            "DPolac\\TwigLambda\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    }
}
